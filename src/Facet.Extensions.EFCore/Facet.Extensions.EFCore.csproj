<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <PackageId>Facet.Extensions.EFCore</PackageId>
        <Description>EF Core async extension methods and design-time services (EF model manifest for navigation-aware DTO generation) for Facet.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Title>Facet.Extensions.EFCore</Title>
        <PackageProjectUrl>https://www.github.com/Tim-Maes/Facet</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <!--
          Design-time-only surface (IDesignTimeServices, MigrationsScaffolder) used by the
          Design/ folder. PrivateAssets="all" keeps it out of the package's dependencies:
          developmentDependency only applies when a package is installed directly, so without
          it every consuming app shipped EFCore.Design and its Roslyn/MSBuild closure. Apps
          that run 'dotnet ef' already reference EFCore.Design themselves (the tool requires
          it), and the design-time host is the only place the Design/ types are touched.
        -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
        <ProjectReference Include="..\Facet.Extensions\Facet.Extensions.csproj" />
    </ItemGroup>

    <!--
      MSB3277 on net8.0 only: EFCore.Design 8 brings Roslyn 4.5, while the generator project
      (reaching this build as a transitive project reference) is built against Roslyn 4.8.
      Neither is part of this package's output or dependencies, so the conflict is build-local.
    -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="FacetEfCoreExtensions.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
        <!--
          buildTransitive (not build/) so the FacetEfDesignTime opt-in property works from
          the startup project too, which typically references this package only transitively
          through the DbContext project.
        -->
        <None Include="buildTransitive\Facet.Extensions.EFCore.targets" Pack="true" PackagePath="buildTransitive\" />
    </ItemGroup>

    <!--
      Override the vulnerable System.Security.Cryptography.Xml that EFCore.Design brings in.
      Private like EFCore.Design itself: it only matters for this build.
    -->
    <ItemGroup>
        <PackageReference Include="System.Security.Cryptography.Xml" PrivateAssets="all" />
    </ItemGroup>

</Project>
