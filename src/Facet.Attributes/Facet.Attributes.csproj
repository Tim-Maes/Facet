<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <PackageId>Facet.Attributes</PackageId>
        <Title>Facet.Attributes</Title>
        <Description>Runtime attributes for the Facet source generator. This package contains only the attributes and enums needed at runtime.</Description>
        <PackageTags>facet source-generator attributes dto projection</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />

        <!--
          Defines FACET_KEEP_ATTRIBUTES in the consuming project, so the [Conditional] attributes
          in this package stay in metadata by default. buildTransitive as well as build, so that a
          project reaching this package through Facet gets it too.
        -->
        <None Include="Facet.Attributes.targets"
              Pack="true"
              PackagePath="build/Facet.Attributes.targets"
              Visible="false" />
        <None Include="Facet.Attributes.targets"
              Pack="true"
              PackagePath="buildTransitive/Facet.Attributes.targets"
              Visible="false" />
    </ItemGroup>

</Project>
