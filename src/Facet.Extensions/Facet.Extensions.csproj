<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <PackageId>Facet.Extensions</PackageId>
        <Description>Provider-agnostic extension methods for Facet.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="" />
        <None Include="FacetExtensions.cs" />
    </ItemGroup>

    <ItemGroup>
        <!--
          Becomes the Facet package dependency, keeping generator and runtime helpers in step.
          The generator assembly is routed into an item type nothing consumes, so it is neither
          compiled against (the Facet package ships no lib/ for consumers either) nor run as an
          analyzer on this library. As a plain reference it pulled Roslyn's
          System.Collections.Immutable into this build, which then had to be pinned and leaked
          to every consumer. ReferenceOutputAssembly="false" would avoid that too, but pack then
          drops the package dependency.
        -->
        <ProjectReference Include="..\Facet\Facet.csproj" OutputItemType="FacetGeneratorOutput" />
    </ItemGroup>

</Project>